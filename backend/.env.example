# ── Server ─────────────────────────────────────────────────────
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# ── Supabase (Service Role — NEVER expose to frontend) ─────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Email (Gmail App Password) ─────────────────────────────────
# Setup: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
FROM_EMAIL="BugToByte Academy <noreply@bugtobyte.com>"
ADMIN_EMAIL=admin@bugtobyte.com

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Zoom (optional) ────────────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Chatbot (Claude) ─────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-replace_me

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────
# Get from: developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_API_VERSION=v20.0
# Make this up yourself — must match the "Verify Token" you enter in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=choose_your_own_verify_token
# Your own personal WhatsApp number (international format, no +), for chatbot handoff notifications
ADMIN_WHATSAPP_NUMBER=
